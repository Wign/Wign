{
  "name": "wign",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Wign/Wign.git"
  },
  "scripts": {
    "development": "sass --no-source-map --silence-deprecation=import resources/assets/sass/app.scss public/css/style.css",
    "watch": "sass --no-source-map --silence-deprecation=import --watch resources/assets/sass/app.scss public/css/style.css",
    "watch-poll": "sass --no-source-map --silence-deprecation=import --watch --poll resources/assets/sass/app.scss public/css/style.css",
    "production": "sass --no-source-map --silence-deprecation=import --style=compressed resources/assets/sass/app.scss public/css/style.css"
  },
  "devDependencies": {
    "sass": "^1.107.1"
  }
}
